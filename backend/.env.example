DEBUG=True
# Production: DEBUG=False and a long random SECRET_KEY (python -c "import secrets;print(secrets.token_urlsafe(50))")
SECRET_KEY=change-me-in-production
# Shared cache for login / mPIN / assistant throttling across gunicorn workers (e.g. redis://localhost:6379/1)
REDIS_CACHE_URL=
ALLOWED_HOSTS=127.0.0.1,localhost
CELERY_BROKER_URL=redis://localhost:6379/0

# --- AI assistant (Claude). Leave empty to use the rule-based assistant ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# --- WhatsApp Business Cloud API (Meta) ---
WHATSAPP_VERIFY_TOKEN=securebank-verify
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
# --- Real SMS OTP: choose ONE provider (msg91 | fast2sms | twilio). Empty = dev mode (OTP shown on screen) ---
SMS_PROVIDER=
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
FAST2SMS_KEY=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
LOGIN_OTP=True

# Staff must open the Aadhaar document before they can approve KYC
KYC_REQUIRE_REVIEW=True
